# Pegá acá el token del bot (Discord Developer Portal → tu app → Bot → Reset Token / Copy)
DISCORD_TOKEN=poné_tu_token_acá

# ID del servidor (clic derecho en el server → Copiar ID de servidor).
# Con esto los comandos slash aparecen al toque. Sin esto tardan hasta 1 hora.
GUILD_ID=poné_el_id_de_tu_server_acá

# Opcional. Si YouTube te bloquea el VPS (error de bot / sign-in),
# exportá cookies del navegador a un archivo y poné la ruta acá.
# YTDLP_COOKIES=./cookies.txt
